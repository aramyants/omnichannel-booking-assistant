# Copy to .env and adjust. Never commit .env.

# Deployment environment: development | staging | production
APP_ENV=development

# Port the HTTP server listens on. Cloud Run overrides this at runtime.
PORT=8080

# Minimum log severity: debug | info | warn | error
LOG_LEVEL=info

# How long in-flight requests may take to drain after a termination signal.
SHUTDOWN_TIMEOUT=15s

# Externally reachable origin of this service, used to register webhooks with
# messaging providers. Must be https. Leave empty locally unless you are
# tunnelling; the service then serves its webhook endpoints without registering
# them.
PUBLIC_BASE_URL=

# Telegram. Leave TELEGRAM_BOT_TOKEN empty to disable the channel entirely.
# The token comes from BotFather. The secret is yours to invent: it is the only
# thing proving a webhook delivery came from Telegram, so generate a random one
# and keep it secret. Allowed characters are A-Z, a-z, 0-9, underscore, hyphen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Override the Telegram API host. Only for local testing against a stub or for
# routing through an egress proxy. Leave empty in production.
TELEGRAM_API_BASE_URL=
