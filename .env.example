# Copy to .env and adjust. Never commit .env.

# Deployment environment: development | staging | production
APP_ENV=development

# Port the HTTP server listens on. Cloud Run overrides this at runtime.
PORT=8080

# Minimum log severity: debug | info | warn | error
LOG_LEVEL=info

# How long in-flight requests may take to drain after a termination signal.
SHUTDOWN_TIMEOUT=15s

# Externally reachable origin of this service, used to register webhooks with
# messaging providers. Must be https. Leave empty locally unless you are
# tunnelling; the service then serves its webhook endpoints without registering
# them.
PUBLIC_BASE_URL=

# Telegram. Leave TELEGRAM_BOT_TOKEN empty to disable the channel entirely.
# The token comes from BotFather. The secret is yours to invent: it is the only
# thing proving a webhook delivery came from Telegram, so generate a random one
# and keep it secret. Allowed characters are A-Z, a-z, 0-9, underscore, hyphen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Override the Telegram API host. Only for local testing against a stub or for
# routing through an egress proxy. Leave empty in production.
TELEGRAM_API_BASE_URL=

# Altegio, the scheduling system. Leave ALTEGIO_PARTNER_TOKEN empty to run
# without it.
#
# The partner token comes from the Altegio marketplace and reaches the public
# booking catalogue on its own. The user token authorises the business's own
# data and is obtained through Altegio's user authorisation method. The company
# id is the location, visible in the Altegio URL when managing the business.
ALTEGIO_PARTNER_TOKEN=
ALTEGIO_USER_TOKEN=
ALTEGIO_COMPANY_ID=

# The business's timezone, as an IANA name such as Asia/Yerevan. A customer
# asking for "Friday at three" means three o'clock where the salon is, and some
# Altegio times arrive without an offset, so this cannot be guessed.
ALTEGIO_TIMEZONE=UTC

# Labels the prices Altegio returns, which carry no currency of their own.
ALTEGIO_CURRENCY=AMD

# What the assistant calls the business when it introduces itself.
BUSINESS_NAME=

# OpenAI. Leave OPENAI_API_KEY empty to run without a language model: the
# assistant then acknowledges messages and hands them to a colleague.
#
# The model is configurable because model names change faster than deployments,
# so correcting one is a configuration change rather than a release. Leave it
# empty to use the built-in default.
OPENAI_API_KEY=
OPENAI_MODEL=

# Override the API hosts. Only for exercising the assistant locally against a
# stub, or for routing through a proxy. Leave empty in production.
OPENAI_BASE_URL=
ALTEGIO_BASE_URL=
